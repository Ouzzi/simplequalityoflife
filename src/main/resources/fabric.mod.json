{
	"schemaVersion": 1,
	"id": "simplequalityoflife",
	"version": "${version}",
	"name": "SimpleQualityOfLife",
	"description": "A modular Fabric mod focused on utility tweaks, movement improvements, farming enhancements, and server administration tools.",
	"authors": [
		"Ouzzi"
	],
	"contact": {
		"homepage": "https://github.com/Ouzzi/simplequalityoflife",
		"sources": "https://github.com/Ouzzi/simplequalityoflife",
		"issues": "https://github.com/Ouzzi/simplequalityoflife/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/simplequalityoflife/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.simplequalityoflife.Simplequalityoflife"
		],
        "client": [
            "com.simplequalityoflife.SimplequalityoflifeClient"
        ],
		"fabric-datagen": [
			"com.simplequalityoflife.SimplequalityoflifeDataGenerator"
		],
        "modmenu": [
          "com.simplequalityoflife.compat.ModMenuIntegration"
        ]
	},
	"mixins": [
		"simplequalityoflife.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}